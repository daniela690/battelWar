<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="battelWar.View.GamePage"
              xmlns:m="clr-namespace:battelWar.Models"
              xmlns:vm="clr-namespace:battelWar.ViewModels"
             Title="GamePage"
              x:DataType="vm:GamePageVM"
              BackgroundColor="#89bcfa">
    <VerticalStackLayout>
        <Label  Text="{Binding OpponentName}" />
        <Button
           Text="{x:Static m:Strings.Start}"
           HorizontalOptions="Start"
           WidthRequest="100"
           HeightRequest="70"
           FontAttributes="Bold"
           FontSize="25"
           CornerRadius="25"
           BackgroundColor="#faaffa"
           TextColor="#FFFFFF90"/>  
        <Grid x:Name="BoardGrid" Padding="5" RowSpacing="1" ColumnSpacing="1" />
        <Label Text="{x:Static m:Strings.PickShip}" HorizontalOptions="Center" />
        <Picker x:Name="ShipSizePicker" HorizontalOptions="Center" ItemsSource="{Binding ShipSizes}" SelectedItem="{Binding SelectedShipSize}"/>
        <Label HorizontalOptions="Center" Text="{Binding StatusMessage}" Margin="50"/>
        <Label HorizontalOptions="Center" Text="{Binding MyName}" />
    </VerticalStackLayout>
</ContentPage>